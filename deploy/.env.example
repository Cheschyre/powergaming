# Template for the real .env in each stack's directory on docker-host:
#   /opt/powergaming-test/.env   and   /opt/powergaming-prod/.env
# Fill in real values. Never commit a real .env -- it's gitignored.
# Test and prod must differ in password and ports (see comments below).

POSTGRES_USER=powergaming
POSTGRES_PASSWORD=changeme
POSTGRES_DB=powergaming

# Host ports the stack publishes. 8080 is taken by another container on
# docker-host. Use 8081/8001 for test, 8082/8002 for prod.
WEB_PORT=8081
API_PORT=8001

# test or prod -- passed to the api container as ENV.
APP_ENV=test

# Optional: comma-separated origins allowed to call the API cross-origin.
# Leave unset -- the frontend uses the API same-origin via nginx.
# CORS_ALLOW_ORIGINS=

# TAG (which image tag to run) is managed by the deploy workflow: every
# deploy rewrites it to the tag it just built (develop for test, the
# version tag, e.g. v1.0.0, for prod). No need to set it by hand.
