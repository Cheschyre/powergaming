# Copy to .env next to docker-compose.test.yml on the VM
# (/opt/powergaming-test/.env) and fill in real values.
# Never commit the real .env -- it's gitignored.

POSTGRES_USER=powergaming
POSTGRES_PASSWORD=changeme
POSTGRES_DB=powergaming

# Which image tag to run. The CD workflow doesn't set this for you --
# it always pulls whatever :develop currently points to (updated on
# every push to develop). Override to a specific commit SHA here only
# if you want to pin the test stack to something other than latest.
TAG=develop

# Host ports the stack publishes. Change these if something else on the
# VM already holds 8080/8001.
WEB_PORT=8080
API_PORT=8001
